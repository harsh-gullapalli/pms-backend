generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  /// Manages every property; not tied to one.
  ADMIN
  /// Works at exactly one property and can only access that property.
  STAFF
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  role         UserRole  @default(STAFF)
  /// Required for STAFF (they can only sign in to and access this property);
  /// null for ADMIN.
  propertyId   String?   @map("property_id") @db.Uuid
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  sessions     Session[]

  @@index([propertyId])
  @@map("users")
}

/// A login session. Access tokens never expire; they stay valid until the
/// session row is deleted by an explicit logout.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum RoomTypeStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum PropertyType {
  HOTEL
  RESORT
  VILLA
  MOTEL
  APARTMENT
}

/// A property managed in the system (hotel, resort, villa, ...). Room types
/// belong to a property.
model Property {
  id                String       @id @default(uuid()) @db.Uuid
  name              String
  /// Short unique identifier, e.g. "GPH".
  code              String       @unique
  type              PropertyType
  description       String?
  address           String?
  city              String
  state             String?
  country           String
  postalCode        String?      @map("postal_code")
  phone             String?
  email             String?
  frontDeskPhone    String?      @map("front_desk_phone")
  emergencyContact  String?      @map("emergency_contact")
  generalEmail      String?      @map("general_email")
  reservationsEmail String?      @map("reservations_email")
  website           String?
  /// 24-hour "HH:mm".
  checkInTime       String       @default("14:00") @map("check_in_time")
  /// 24-hour "HH:mm".
  checkOutTime      String       @default("11:00") @map("check_out_time")
  /// ISO 4217 code, e.g. "INR".
  defaultCurrency   String       @map("default_currency")
  numberOfFloors    Int?         @map("number_of_floors")
  totalRooms        Int?         @map("total_rooms")
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  roomTypes         RoomType[]
  users             User[]

  @@map("properties")
}

/// A category of room (e.g. Deluxe King) at one property, with the number of
/// rooms of that type, how many guests each sleeps, and its nightly base rate.
model RoomType {
  id         String         @id @default(uuid()) @db.Uuid
  propertyId String         @map("property_id") @db.Uuid
  name       String
  roomCount  Int            @map("room_count")
  capacity   Int
  baseRate   Decimal        @map("base_rate") @db.Decimal(10, 2)
  status     RoomTypeStatus @default(ACTIVE)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  property   Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([propertyId, name])
  @@map("room_types")
}
