generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]

  @@map("users")
}

/// A login session. Access tokens never expire; they stay valid until the
/// session row is deleted by an explicit logout.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum RoomTypeStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

/// A hotel/resort managed in the system. Room types belong to a property.
model Property {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  /// Short unique identifier, e.g. "GPH".
  code      String     @unique
  address   String?
  city      String
  country   String
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  roomTypes RoomType[]

  @@map("properties")
}

/// A category of room (e.g. Deluxe King) at one property, with the number of
/// rooms of that type, how many guests each sleeps, and its nightly base rate.
model RoomType {
  id         String         @id @default(uuid()) @db.Uuid
  propertyId String         @map("property_id") @db.Uuid
  name       String
  roomCount  Int            @map("room_count")
  capacity   Int
  baseRate   Decimal        @map("base_rate") @db.Decimal(10, 2)
  status     RoomTypeStatus @default(ACTIVE)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  property   Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([propertyId, name])
  @@map("room_types")
}
